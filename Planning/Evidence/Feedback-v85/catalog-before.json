  "stories": [
    {
      "id": "story_boss_10",
      "stage": 10,
      "bossId": "bell_knight",
      "lines": [
        {
          "speaker": "종의 기사",
          "text": "나는 마을을 지키는 줄 알았다.\n그런데 이 문은 주민들을 가두고 있었지.",
          "responses": []
        },
        {
          "speaker": "종의 기사",
          "text": "첫 종을 울려, 문을 열어라.\n집마다 걸린 사슬을 따라가 보거라.",
          "responses": []
        },
        {
          "speaker": "선택한 종지기",
          "text": "등불이 닿는 곳까지 가볼게.\n안에 있는 사람들을 찾아야 해.",
          "responses": [
            {
              "characterId": "on",
              "text": "등불이 닿는 곳까지 가볼게.\n안에 있는 사람들을 찾아야 해."
            },
            {
              "characterId": "dam",
              "text": "문은 내가 열겠다.\n안에 남은 사람들을 되찾아 오지."
            },
            {
              "characterId": "rin",
              "text": "문 안에서 목소리가 들려.\n사슬 너머에서 누군가 기다리고 있어."
            }
          ]
        }
      ]
    },
    {
      "id": "story_boss_20",
      "stage": 20,
      "bossId": "chain_jailer",
      "lines": [
        {
          "speaker": "매달린 집행관",
          "text": "저 집의 사람들은 죽지 않았다.\n빼앗긴 내일 속에 잠들어 있지.",
          "responses": []
        },
        {
          "speaker": "매달린 집행관",
          "text": "사슬로 거둔 시간이 탑에 남아 있다.\n이제 종을 울려, 집으로 돌려보내라.",
          "responses": []
        },
        {
          "speaker": "선택한 종지기",
          "text": "그럼, 한 집도 빠뜨리지 않을게.\n다음 종까지 등불을 이어갈 거야.",
          "responses": [
            {
              "characterId": "on",
              "text": "그럼, 한 집도 빠뜨리지 않을게.\n다음 종까지 등불을 이어갈 거야."
            },
            {
              "characterId": "dam",
              "text": "돌려받을 몫이 남아 있었군.\n사슬을 풀고, 모두의 아침을 되찾겠다."
            },
            {
              "characterId": "rin",
              "text": "들려. 저마다 다른 목소리야.\n종을 울려서, 집으로 보내줄게."
            }
          ]
        }
      ]
    }
  ],
  "onboarding": {
