  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.15294118, g: 0.23921569, b: 0.27058825, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 040d1266578d09b45943d341eef6d9b7, type: 3}
    m_FontSize: 28
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.2
  m_Text: "\uB9C8\uC9C0\uB9C9 \uC885\uC9C0\uAE30 \xB7 v8.6 \uD604\uC7AC \uC0AC\uC6A9
    \uC74C\uC6D0\r\n\uC0C8 \uBC30\uACBD\uC74C\xB7\uACF5\uACA9\uC74C\xB7\uD68C\uD53C\uC74C:
    CC0-1.0\r\n\r\n\uB85C\uBE44 \xB7 Stage Select\r\nJuhani Junkala [Chiptune Adventures]
    4. Stage Select \u2014 Juhani Junkala / SubspaceAudio\r\nhttps://opengameart.org/content/4-chiptunes-adventure\r\nCC0-1.0\r\nFixed
    gain 0.640232; stereo 44.1kHz Vorbis; original full loop and tempo preserved,
    no added bell layer.\r\n\r\n\uC131 \uBC16 \xB7 Stage 1\r\nJuhani Junkala [Chiptune
    Adventures] 1. Stage 1 \u2014 Juhani Junkala / SubspaceAudio\r\nhttps://opengameart.org/content/4-chiptunes-adventure\r\nCC0-1.0\r\nFixed
    gain 0.523584; stereo 44.1kHz Vorbis; original full loop and tempo preserved,
    no added bell layer.\r\n\r\n\uC8FC\uAC70\uAD6C \xB7 Stage 2\r\nJuhani Junkala
    [Chiptune Adventures] 2. Stage 2 \u2014 Juhani Junkala / SubspaceAudio\r\nhttps://opengameart.org/content/4-chiptunes-adventure\r\nCC0-1.0\r\nFixed
    gain 0.510633; stereo 44.1kHz Vorbis; original full loop and tempo preserved,
    no added bell layer.\r\n\r\n\uBCF4\uC2A4 \xB7 Boss Fight\r\nJuhani Junkala [Chiptune
    Adventures] 3. Boss Fight \u2014 Juhani Junkala / SubspaceAudio\r\nhttps://opengameart.org/content/4-chiptunes-adventure\r\nCC0-1.0\r\nFixed
    gain 0.526855; stereo 44.1kHz Vorbis; original full loop and tempo preserved,
    no added bell layer.\r\n\r\n\uACF5\uACA9 \xB7 \uC9E7\uC740 \uBCA0\uAE30\r\nRPG
    Audio: knifeSlice2 + chop \u2014 Kenney\r\nhttps://kenney.nl/assets/rpg-audio\r\nCC0-1.0\r\nOnset
    trim 0.015782/0.017188s, EQ, layer blade .85 + chop .65, 280ms, 2ms attack/35ms
    release, fixed gain 0.724140.\r\n\r\n\uC77C\uBC18\xB7\uC644\uBCBD \uD68C\uD53C
    \xB7 \uBC14\uB78C\r\nSwosh / Whoosh / Air Cut \u2014 qubodup\r\nhttps://freesound.org/people/qubodup/sounds/60030/\r\nCC0-1.0\r\nPublic
    HQ MP3 preview; 45\u2013315ms excerpt, highpass240/lowpass8500, 2ms/30ms fades,
    fixed gain 0.871424. Accepted input plays once; perfect result does not add a
    bell or duplicate.\r\n\r\n\uC720\uC9C0 \uD6A8\uACFC\uC74C: \uD53C\uACA9 Impact:
    Smack Body \u2014 Philipp Grzemba / Sheyvan (CC0)\r\nhttps://freesound.org/people/Sheyvan/sounds/540752/\r\n\uC801
    \uBB34\uAE30 \uCDA9\uB3CC: Medieval sound effects \u2014 Weapon impacts \u2014
    Ben Jaszczak & Brian Nelson / Still North Media (CC0)\r\nhttps://opengameart.org/content/medieval-sound-effects-weapon-impacts\r\n\uBC1C\uC18C\uB9AC:
    Kenney RPG Audio (CC0), \uCDA9\uACA9: Kenney Impact Sounds (CC0)\r\nhttps://kenney.nl/assets/impact-sounds\r\n\uB4F1\uBD88
    \uC810\uD654\xB7\uB4F1\uC7A5\xB7\uACE8\uB4DC \uD68D\uB4DD \uD6A8\uACFC: Last
    Bell \uC790\uCCB4 \uD569\uC131.\r\n\uC885 \uD6A8\uACFC\uC74C\uACFC \uAE30\uC874
    \uC5B4\uB450\uC6B4 BGM\uC740 \uC7AC\uC0DD\uD558\uC9C0 \uC54A\uC74C.\r\nCC0 1.0:
    https://creativecommons.org/publicdomain/zero/1.0/\r\n\uC774\uC804 v7.2 \uC0AC\uC6A9
    \uC774\uB825\uACFC CC BY \uC6D0\uBB38\uC740 historical-v72-* \uD30C\uC77C\uB85C
    \uBCF4\uC874.\r\n"
